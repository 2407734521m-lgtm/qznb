# Supabase 控制台 → Project Settings → API。只填 URL 和 anon/publishable key。
# 绝对不要填 service_role 密钥。
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 仅在服务端真实邮箱验证、发信及回跳均验收后开启；默认不显示邮箱兜底按钮。
VITE_USERNAME_EMAIL_RECOVERY_ENABLED=false

# 仅在 HTTPS 同源 /api 代理正确传递 Cookie/Set-Cookie 并完成验收后开启。
VITE_USERNAME_TRUSTED_DEVICE_ENABLED=false
